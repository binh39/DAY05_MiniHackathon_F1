GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

GEMINI_DOCUMENT_MODEL=gemini-3.5-flash
GEMINI_PLANNER_MODEL=gemini-3.5-flash
GEMINI_SCRIPT_MODEL=gemini-3.5-flash
GEMINI_STORYBOARD_MODEL=gemini-3.5-flash
GEMINI_SUMMARY_MODEL=gemini-3.5-flash

TTS_PROVIDER=google
FFMPEG_PATH=ffmpeg

API_HOST=127.0.0.1
API_PORT=8787
FRONTEND_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# Optional fallback. Per-module values below take precedence.
PIPELINE_TIMEOUT_MS=
PIPELINE_MODULE1_TIMEOUT_MS=600000
PIPELINE_MODULE2_TIMEOUT_MS=480000
PIPELINE_MODULE3_TIMEOUT_MS=600000
PIPELINE_MODULE4_TIMEOUT_MS=480000
PIPELINE_MODULE5A_TIMEOUT_MS=1200000
PIPELINE_MODULE5B_TIMEOUT_MS=900000
PIPELINE_MODULE6_TIMEOUT_MS=900000
FIREBASE_AUTH_REQUIRED=true
FIREBASE_STORAGE_BUCKET=project-5d300c02-d165-4037-b6f.firebasestorage.app

# Production: Firestore/Storage are the source of truth and every pipeline run
# is dispatched to the Cloud Run Job below. Keep both values on `local` while
# developing without deployed Google Cloud resources.
PERSISTENCE_MODE=local
PIPELINE_EXECUTION_MODE=local
CLOUD_RUN_REGION=asia-southeast1
CLOUD_RUN_JOB_NAME=ai-lecture-worker

# Per-user cost and storage guardrails.
USER_MAX_ACTIVE_JOBS=2
USER_MAX_STORED_JOBS=20
USER_MAX_STORAGE_MEGABYTES=2048
USER_MONTHLY_VIDEO_MINUTES=60

# 0 disables automatic cleanup. Terminal jobs older than this are deleted
# from local storage, Firestore and Firebase Storage at API startup.
JOB_RETENTION_DAYS=30
